# =============================================================================
# The Lenny Growth Assistant — configuration
# Copy to `.env` and adjust. Every value here is a safe default that boots.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Database
# -----------------------------------------------------------------------------
# Local Compose default. To use Supabase/Railway instead, replace this one line
# with their connection string — no application code changes.
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny_dev_password
POSTGRES_DB=lenny
DATABASE_URL=postgresql+asyncpg://lenny:lenny_dev_password@postgres:5432/lenny

# -----------------------------------------------------------------------------
# REQUIRED: Which LLM provider serves requests
# -----------------------------------------------------------------------------
# One of: "ollama" (local, default, no API key) | "openai_compat" (cloud)
# This is the toggle the evaluator flips. Nothing else needs to change.
LLM_PROVIDER=ollama

# If the selected provider is unreachable, fall back to this one.
# Set to "none" to disable fallback and surface a hard error instead.
LLM_FALLBACK_PROVIDER=none

# -----------------------------------------------------------------------------
# Provider: Ollama (local — used for the mandatory demo)
# -----------------------------------------------------------------------------
# From inside Docker, the host's Ollama is at host.docker.internal.
# If running the backend outside Docker, use http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
# llama3.2:3b   -> fast, good for demos on CPU-only machines
# qwen2.5:7b-instruct -> slower on CPU, noticeably better long-form writing
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=180

# -----------------------------------------------------------------------------
# Provider: OpenAI-compatible cloud (Hugging Face router / OpenAI / Groq / ...)
# -----------------------------------------------------------------------------
# OPTIONAL — only needed when LLM_PROVIDER=openai_compat.
# Hugging Face Inference router (open-source models, free tier):
#   LLM_BASE_URL=https://router.huggingface.co/v1
#   LLM_MODEL=Qwen/Qwen3-32B
#   LLM_API_KEY=hf_xxx
# OpenAI:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
#   LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_MODEL=Qwen/Qwen3-32B
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# Retrieval
# -----------------------------------------------------------------------------
# fastembed/ONNX — no torch, fast on CPU. Change dim if you change the model.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# Mounted volume for model weights. Without this the ~130MB model is
# re-downloaded on every container restart.
EMBEDDING_CACHE_DIR=/data/models
RETRIEVAL_TOP_K=8
# Absolute cosine-similarity floor. If no chunk clears it, the agent must say
# the transcripts don't cover the question instead of answering from memory.
# Measured via `python -m app.evals.run_eval`, not guessed -- see the comment
# on this setting in app/config.py for the data behind 0.69.
RETRIEVAL_MIN_SIMILARITY=0.69
# Sized to fit the bge-small-en-v1.5 512-token window with headroom.
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=80

# -----------------------------------------------------------------------------
# Ingestion
# -----------------------------------------------------------------------------
TRANSCRIPTS_REPO_URL=https://github.com/ChatPRD/lennys-podcast-transcripts.git
TRANSCRIPTS_LOCAL_PATH=/data/lennys-transcripts
# Cap episodes ingested; 0 = all 303. Lower this for a fast first run.
INGEST_EPISODE_LIMIT=0
# Auto-build the knowledge base on first boot so `docker compose up` is enough.
INGEST_ON_STARTUP=true

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# "json" for machine-readable structured logs, "console" for human-readable dev
LOG_FORMAT=console
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
